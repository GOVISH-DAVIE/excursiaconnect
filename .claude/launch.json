{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "excursiaconnect-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@excursia/web",
        "--",
        "-p",
        "3010"
      ],
      "port": 3010
    },
    {
      "name": "excursiaconnect-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@excursia/api"
      ],
      "port": 4000
    },
    {
      "name": "excursiaconnect-api-fresh",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LOCAL_DATABASE=excursia_fresh",
        "WEB_ORIGINS=http://localhost:3010,http://localhost:3011",
        "npm",
        "run",
        "dev",
        "-w",
        "@excursia/api"
      ],
      "port": 4000
    },
    {
      "name": "excursiaconnect-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "@excursia/web",
        "--",
        "-H",
        "127.0.0.1",
        "-p",
        "3012"
      ],
      "port": 3012
    }
  ]
}
