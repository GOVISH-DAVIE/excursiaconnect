{
  "name": "excursiaconnect",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @excursia/web",
    "dev:api": "npm run dev -w @excursia/api",
    "build": "npm run build -w @excursia/web && npm run build -w @excursia/api",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:setup": "scripts/db/setup-local.sh",
    "db:migrate": "npm run migrate -w @excursia/db",
    "db:deploy": "npm run deploy -w @excursia/db",
    "db:generate": "npm run generate -w @excursia/db",
    "postinstall": "npm run generate -w @excursia/db"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
