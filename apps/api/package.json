{
  "name": "@excursia/api",
  "version": "0.1.0",
  "private": true,
  "description": "The API: Express on its own subdomain, the only process that talks to the database.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "check-demo": "tsx src/cli/check-demo.ts",
    "import": "tsx src/cli/import-reference.ts",
    "admin": "tsx src/cli/create-admin.ts",
    "mail:check": "tsx src/cli/check-mail.ts",
    "load:apply": "tsx src/cli/load-apply.ts",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@excursia/contracts": "*",
    "@excursia/db": "*",
    "@excursia/domain": "*",
    "@node-rs/argon2": "2.2.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nodemailer": "10.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
