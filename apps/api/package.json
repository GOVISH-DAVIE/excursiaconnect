{
  "name": "@excursia/api",
  "version": "0.1.0",
  "private": true,
  "description": "The API: Express on its own subdomain, the only process that talks to the database.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
