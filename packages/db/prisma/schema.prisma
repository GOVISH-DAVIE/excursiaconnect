// ExcursiaConnect's database: the first schema (backend-plan.md, M0.2).
//
// Two storage styles, chosen by volume (backend-plan.md, Architecture):
// - Aggregate records: the Deal Room's business records are stored whole as JSONB in `record`, with indexed summary
//   columns the save step keeps in step. Lists and dashboards read the summary columns; the rules read the record.
// - Normalised tables: identity, money, messages, files, audit, and the rows that must be unique or exclusive
//   (busy slots, counters, badges, payments), which the database itself enforces.
//
// Tables and columns are snake_case in PostgreSQL; times are timestamptz; every table carries its event where it
// belongs to one. What Prisma cannot express (the exclusion constraints, partial and expression indexes, grants)
// is in the migrations' SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------------------------------------------

enum UserKind {
  admin // Algotech
  staff // an organiser's or the Deal Room's team
  participant // an applicant, delegate or exhibitor contact
}

model User {
  id            String    @id @default(uuid(7))
  kind          UserKind
  email         String?   @unique @db.Citext
  phone         String?   @unique
  name          String
  passwordHash  String?   @map("password_hash") // staff only (argon2); participants sign in with one-time codes
  demo          Boolean   @default(false) // made by the demo seed; production holds none (backend-plan.md, M0.3)
  mfaGraceUntil DateTime? @map("mfa_grace_until") @db.Timestamptz(3) // staff may skip the authenticator until then (D14)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(3)

  sessions    Session[]
  memberships Membership[]
  totp        TotpSecret?

  @@map("app_user")
}

/// A signed-in session. The cookie holds a random token; only its hash is stored.
model Session {
  id           String    @id @default(uuid(7))
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3) // absolute limit
  stepUpAt     DateTime? @map("step_up_at") @db.Timestamptz(3) // last TOTP or PIN confirmation
  mfaSkipped   Boolean   @default(false) @map("mfa_skipped") // a staff session that chose "set up later" (D14)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  scanEventId  String?   @map("scan_event_id") // a scanner signed in for one event
  scanDeviceId String?   @map("scan_device_id")
  ip           String?
  userAgent    String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

enum OtpPurpose {
  sign_in
  verify_contact
  set_password // a staff member setting or resetting their password
}

/// A one-time code, hashed: 10-minute expiry, single use, five attempts (backend-plan.md, Security model).
model OtpCode {
  id          String     @id @default(uuid(7))
  destination String // an email or a phone number, normalised
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([destination, purpose, createdAt])
  @@map("otp_code")
}

/// A staff member's TOTP: the secret encrypted at rest, reuse of a step blocked, recovery codes hashed.
model TotpSecret {
  userId             String    @id @map("user_id")
  secretEncrypted    String    @map("secret_encrypted")
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedStep       BigInt?   @map("last_used_step")
  recoveryCodeHashes String[]  @map("recovery_code_hashes")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_secret")
}

enum MembershipRole {
  admin // Algotech
  // an organiser's team (src/lib/roles.ts)
  owner
  org_staff
  finance
  accreditation
  speaker
  // the Deal Room's staff (DrStaff roles)
  dr_lead
  dr_reviewer
  dr_operations
  dr_coordinator
  dr_oversight
}

/// What a user may do, and where: for an organiser, for one event, or everywhere (Algotech).
model Membership {
  id          String         @id @default(uuid(7))
  userId      String         @map("user_id")
  role        MembershipRole
  organiserId String?        @map("organiser_id")
  eventId     String?        @map("event_id")
  canDecide   Boolean        @default(false) @map("can_decide") // a Deal Room reviewer who may decide
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt   DateTime?      @map("revoked_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organiser Organiser? @relation(fields: [organiserId], references: [id])
  event     Event?     @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId, role])
  @@map("membership")
}

/// A phone or tablet registered to scan at one event; PIN failures lock the device (backend-plan.md).
model ScannerDevice {
  id          String    @id @default(uuid(7))
  eventId     String    @map("event_id")
  name        String
  pinFailures Int       @default(0) @map("pin_failures")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("scanner_device")
}

/// Who did what, when. The app and worker may only INSERT here (the migration revokes the rest).
model AuditEntry {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now()) @db.Timestamptz(3)
  actorKind String   @map("actor_kind") // the Actor kinds in src/lib/ctx.ts
  actorId   String?  @map("actor_id")
  eventId   String?  @map("event_id")
  entity    String // for example "dr_application"
  entityId  String   @map("entity_id")
  action    String // the rule's action type, for example "dr/decide"
  detail    Json?
  ip        String?

  @@index([entity, entityId, at])
  @@index([eventId, at])
  @@map("audit_entry")
}

/// A fixed-window counter for rate limits kept in the database (per phone, email, account or device).
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limit")
}

// ---------------------------------------------------------------------------------------------------------------
// Events, tiers, delegates and badges (minimal until Phase 2)
// ---------------------------------------------------------------------------------------------------------------

model Organiser {
  id        String   @id
  name      String
  record    Json // the organiser as the rules know it, until Phase 2 normalises it
  demo      Boolean  @default(false) // made by the demo seed; production holds none
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  events      Event[]
  memberships Membership[]

  @@map("organiser")
}

model Event {
  id          String   @id
  organiserId String   @map("organiser_id")
  slug        String   @unique
  name        String
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  timezone    String   @default("Africa/Nairobi")
  demo        Boolean  @default(false) // made by the demo seed; everything with this event's id goes with it
  state       String // Draft, Under review, Live, Closed… (src/lib/types.ts EventState)
  record      Json // the event as the rules know it
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organiser      Organiser       @relation(fields: [organiserId], references: [id])
  tiers          Tier[]
  delegates      Delegate[]
  memberships    Membership[]
  scannerDevices ScannerDevice[]
  drConfig       DrConfig?

  @@index([organiserId])
  @@map("event")
}

model Tier {
  id       String @id
  eventId  String @map("event_id")
  name     String
  price    Int // whole units of the currency, as the rules use them
  currency String
  cap      Int?
  record   Json

  event     Event      @relation(fields: [eventId], references: [id])
  delegates Delegate[]

  @@index([eventId])
  @@map("tier")
}

model Delegate {
  id           String   @id
  eventId      String   @map("event_id")
  tierId       String   @map("tier_id")
  name         String
  email        String?  @db.Citext
  phone        String?
  organisation String?
  category     String
  status       String // Confirmed, Pending, Awaiting payment… (src/lib/types.ts DelegateStatus)
  accredited   Boolean  @default(false)
  exhibitorId  String?  @map("exhibitor_id")
  record       Json // the rest of the delegate until Phase 2 normalises it
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event  @relation(fields: [eventId], references: [id])
  tier  Tier   @relation(fields: [tierId], references: [id])
  badge Badge?

  @@index([eventId, status])
  @@index([eventId, email])
  @@map("delegate")
}

/// A badge code: random, unique regardless of case (an expression index in the migration), retried on clash.
model Badge {
  code       String    @id
  delegateId String    @unique @map("delegate_id")
  eventId    String    @map("event_id")
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  delegate Delegate @relation(fields: [delegateId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("badge")
}

// ---------------------------------------------------------------------------------------------------------------
// Deal Room: aggregate records (JSONB plus summary columns)
// ---------------------------------------------------------------------------------------------------------------

model DrConfig {
  eventId   String   @id @map("event_id")
  record    Json // DrConfigRecord (apps/api/src/modules/dealroom/dealroom.mapper.ts): the config and the aggregate's extras
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id])

  @@map("dr_config")
}

model DrStaff {
  id        String   @id
  eventId   String   @map("event_id")
  userId    String?  @map("user_id") // the sign-in, once staff accounts are real (M0.4)
  role      String
  active    Boolean
  record    Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([eventId])
  @@index([userId])
  @@map("dr_staff")
}

model DrApplication {
  id             String    @id
  eventId        String    @map("event_id")
  type           String // seeker | provider
  status         String // AppStatus
  ref            String?
  assigneeId     String?   @map("assignee_id")
  delegateId     String?   @map("delegate_id")
  mission        String?
  track          String?
  decision       String? // the latest effective decision
  readiness      String?
  feeState       String?   @map("fee_state") // owed | paid | waived
  pipelineStatus String?   @map("pipeline_status")
  pipelineSince  DateTime? @map("pipeline_since") @db.Timestamptz(3)
  contactEmail   String?   @map("contact_email") @db.Citext // to find a draft by the applicant's sign-in
  record         Json // DrApplication in src/lib/dealroom/types.ts
  version        Int       @default(0) // bumped on every save, for optimistic checks outside the event lock
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([eventId, ref])
  @@index([eventId, type, status])
  @@index([eventId, mission])
  @@index([eventId, assigneeId])
  @@index([eventId, contactEmail])
  @@index([delegateId])
  @@map("dr_application")
}

model DrMatch {
  id         String   @id
  eventId    String   @map("event_id")
  seekerId   String   @map("seeker_id")
  providerId String   @map("provider_id")
  decision   String
  record     Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([seekerId, providerId])
  @@index([eventId, decision])
  @@map("dr_match")
}

model DrMeeting {
  id         String   @id
  eventId    String   @map("event_id")
  matchId    String   @map("match_id")
  seekerId   String   @map("seeker_id")
  providerId String   @map("provider_id")
  roomId     String?  @map("room_id")
  tableNo    Int?     @map("table_no")
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  status     String
  record     Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([eventId, startsAt])
  @@index([matchId])
  @@index([seekerId])
  @@index([providerId])
  @@map("dr_meeting")
}

model DrSession {
  id        String   @id
  eventId   String   @map("event_id")
  roomId    String   @map("room_id")
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  cancelled Boolean  @default(false)
  record    Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([eventId, startsAt])
  @@map("dr_session")
}

model DrOpportunity {
  id        String   @id
  eventId   String   @map("event_id")
  matchId   String   @map("match_id")
  meetingId String?  @map("meeting_id")
  ownerId   String   @map("owner_id")
  stage     String
  closed    Boolean  @default(false)
  record    Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([matchId])
  @@index([meetingId])
  @@map("dr_opportunity")
}

model DrException {
  id      String   @id
  eventId String   @map("event_id")
  at      DateTime @db.Timestamptz(3)
  record  Json

  @@index([eventId, at])
  @@map("dr_exception")
}

model DrIncident {
  id      String   @id
  eventId String   @map("event_id")
  at      DateTime @db.Timestamptz(3)
  record  Json

  @@index([eventId, at])
  @@map("dr_incident")
}

// ---------------------------------------------------------------------------------------------------------------
// Deal Room: normalised tables the database enforces
// ---------------------------------------------------------------------------------------------------------------

enum BusySource {
  meeting
  session
}

/// Every slot a meeting or session currently holds, per room and table, and per participant. Exclusion
/// constraints in the migration forbid two active rows with the same key whose time ranges overlap, so no room,
/// table or person can be double-booked, however many requests arrive at once (backend-plan.md, Concurrency).
model DrBusy {
  id        String                   @id @default(uuid(7))
  eventId   String                   @map("event_id")
  source    BusySource
  sourceId  String                   @map("source_id")
  key       String // "room:<roomId>:<table>" or "app:<applicationId>"
  slot      Unsupported("tstzrange")
  active    Boolean                  @default(true)
  confirmBy DateTime?                @map("confirm_by") @db.Timestamptz(3) // a proposal lapses after this

  @@index([eventId, sourceId])
  @@map("dr_busy")
}

/// Sequences per event: application references, invoice numbers. Incremented with UPDATE … RETURNING.
model DrCounter {
  eventId String @map("event_id")
  kind    String // "cs", "fp", …
  n       Int    @default(0)

  @@id([eventId, kind])
  @@map("dr_counter")
}

/// A seeker's consent for one document to one provider; the latest row decides.
model DrConsent {
  id         String   @id
  eventId    String   @map("event_id")
  seekerId   String   @map("seeker_id")
  providerId String   @map("provider_id")
  docId      String   @map("doc_id")
  granted    Boolean
  version    Int
  at         DateTime @db.Timestamptz(3)

  @@index([seekerId, providerId, docId, at(sort: Desc)])
  @@map("dr_consent")
}

/// Every view or download of a seeker's profile or documents (the access log).
model DrAccess {
  id       String   @id
  eventId  String   @map("event_id")
  seekerId String   @map("seeker_id")
  item     String // "profile", "teaser" or a document id
  viewer   String // the provider's application id, or "admin" under a support grant
  action   String // view | download
  at       DateTime @db.Timestamptz(3)

  @@index([seekerId, at])
  @@map("dr_access")
}

// ---------------------------------------------------------------------------------------------------------------
// Money, messages and files
// ---------------------------------------------------------------------------------------------------------------

enum PaymentProvider {
  mpesa
  card
  bank
}

enum PaymentStatus {
  pending // the push or checkout started
  confirmed // the provider confirmed and we verified it
  failed
  refunded
}

/// A payment, for a Deal Room fee or a ticket order. The provider's own transaction id is unique, so a repeated
/// webhook inserts nothing; the raw payload is kept for reconciliation.
model Payment {
  id            String          @id @default(uuid(7))
  provider      PaymentProvider
  providerTxnId String?         @map("provider_txn_id") // CheckoutRequestID, the card reference…
  receipt       String?         @unique // the M-Pesa receipt number, once confirmed
  eventId       String          @map("event_id")
  purpose       String // "dr_fee" | "order"
  subjectId     String          @map("subject_id") // the application or order it pays
  amount        Int
  currency      String
  kesAmount     Int?            @map("kes_amount") // locked when the M-Pesa push starts
  phone         String?
  callbackToken String?         @map("callback_token") // hash of the per-transaction token in the callback path
  status        PaymentStatus   @default(pending)
  rawPayload    Json?           @map("raw_payload")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt   DateTime?       @map("confirmed_at") @db.Timestamptz(3)

  @@unique([provider, providerTxnId])
  @@index([subjectId])
  @@index([eventId, status])
  @@map("payment")
}

enum Channel {
  email
  sms
  email_and_sms
  push
}

enum OutboxStatus {
  queued
  sending
  sent
  delivered
  failed
}

/// Email, SMS and push, written in the same transaction as the change that causes them and sent by the worker.
model OutboxMessage {
  id            String       @id
  eventId       String?      @map("event_id")
  recipient     String // an application, staff or delegate id, as the rules address it
  channel       Channel
  subject       String
  link          String
  status        OutboxStatus @default(queued)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  providerId    String?      @map("provider_id") // the provider's message id, for delivery reports
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt        DateTime?    @map("sent_at") @db.Timestamptz(3)

  @@index([recipient, createdAt])
  @@map("outbox_message")
}

enum FileState {
  quarantine
  clean
  rejected
}

/// A document or image in object storage. It is uploaded straight to the bucket, held in quarantine until the
/// virus scan clears it, and deleted at its retention date.
model File {
  id             String    @id
  eventId        String?   @map("event_id")
  ownerKind      String    @map("owner_kind") // "dr_application", "event", "exhibitor"…
  ownerId        String    @map("owner_id")
  storageKey     String    @unique @map("storage_key")
  name           String
  contentType    String    @map("content_type")
  size           Int
  state          FileState @default(quarantine)
  retentionUntil DateTime? @map("retention_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerKind, ownerId])
  @@map("file")
}
